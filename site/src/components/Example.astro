---
// One example of a component, alone on a plain ground: the library drawing
// it, and under it the code that does. `section` is its place among the
// sections of the component's gallery page.
import { Code } from 'astro:components';
import Icon from './Icon.astro';
const { page, section, variant, title, label, place, code = '', codeSource, height = 220 } = Astro.props;
const id = `example-${page}-${section ?? 'all'}-${variant ?? 'all'}`;
---
<figure class="specimen" data-example>
  {label && <figcaption>{label}{place && <span>{place}</span>}</figcaption>}
  <p id={`${id}-scroll-hint`} class="example-scroll-hint" data-scroll-hint hidden>Scroll to explore the preview. Use arrow keys or swipe the strip below the preview.</p>
  <div class="example-viewport" role="region" aria-label={`${title}, scrollable preview`} aria-describedby={`${id}-scroll-hint`} tabindex="-1" data-preview-viewport>
    <iframe class="live" title={`${title}, drawn by limn`} data-page={page} data-section={section} data-variant={variant} style={`height:${height}px`}></iframe>
    <div class="example-scroll-gutter" aria-hidden="true" data-scroll-gutter hidden></div>
  </div>
  {(code || codeSource) && (
    <details class="specimen-code">
      <summary><span><Icon name="code-slash" size={13} /> Code</span>{codeSource && <a href={codeSource}>Source <Icon name="arrow-up-right" size={11} /></a>}</summary>
      {code ? <Code code={code} lang="rust" themes={{ light: 'github-light', dark: 'github-dark-default' }} /> : <p class="example-empty">Read the source of this example.</p>}
    </details>
  )}
</figure>
<script>
  // A preview wider than its card can be scrolled, and says so.
  for (const example of document.querySelectorAll<HTMLElement>('[data-example]')) {
    const viewport = example.querySelector<HTMLElement>('[data-preview-viewport]')!;
    const hint = example.querySelector<HTMLElement>('[data-scroll-hint]')!;
    const gutter = example.querySelector<HTMLElement>('[data-scroll-gutter]')!;
    const updateOverflow = () => {
      if (!viewport.clientWidth) return;
      const overflows = viewport.scrollWidth > viewport.clientWidth + 1;
      hint.hidden = !overflows;
      gutter.hidden = !overflows;
      viewport.tabIndex = overflows ? 0 : -1;
    };
    new ResizeObserver(updateOverflow).observe(viewport);
    updateOverflow();
  }
</script>
