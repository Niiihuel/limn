---
import '../styles/site.css';
import '../styles/docs.css';
import Icon from '../components/Icon.astro';
import { REPO } from '../data/site';
const { title, description = 'A native UI library for Rust.', variant = 'docs', bodyClass, canonical = Astro.url.pathname } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['/docs/', 'Docs', 'book'],
  ['/design-system/', 'Design system', 'palette'],
  ['/components/', 'Components', 'grid'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title ? `${title} · limn` : 'limn — a native UI library for Rust'}</title>
    <script is:inline>
      // Before the first paint, so a light page never flashes dark.
      const saved = localStorage.getItem('theme');
      if (saved ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : '')) document.documentElement.dataset.theme = saved ?? 'light';
    </script>
  </head>
  <body class={bodyClass} data-layout={variant}>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="bar">
      <a class="brand" href="/">limn</a>
      <nav aria-label="Site">
        {nav.map(([href, label, icon]) => <a href={href} data-nav={href} aria-current={path.startsWith(href) ? 'page' : undefined}><Icon name={icon} />{label}</a>)}
      </nav>
      <div class="end">
        <a href={`${REPO}/blob/main/CHANGELOG.md`}><Icon name="journal-text" />Changelog</a>
        <a href={REPO}><Icon name="github" />GitHub</a>
        <button id="theme" type="button" aria-label="Switch between the light and the dark theme">
          <span class="when-dark"><Icon name="sun" /></span><span class="when-light"><Icon name="moon-stars" /></span>
        </button>
      </div>
    </header>
    <slot />
    <template id="copy"><button class="copy" type="button" aria-label="Copy the code"><span class="idle"><Icon name="clipboard" size={14} /></span><span class="done"><Icon name="check2" size={14} /></span></button></template>
    <footer>limn is free software under MIT or Apache-2.0. The examples on this site are the library itself, compiled to WebAssembly.</footer>
    <script is:inline>
      // An embedded gallery follows the site's theme. Each one is a program
      // with a drawing context of its own, and a browser allows few: an
      // example runs while it is near the window and stops when it is far.
      const near = new IntersectionObserver((entries) => {
        for (const { target, isIntersecting } of entries) {
          target.dataset.near = isIntersecting ? 'yes' : '';
          run(target);
        }
      }, { rootMargin: '600px 0px' });
      const run = (frame) => {
        // One that never ran has nothing to stop.
        if (!frame.dataset.near && !frame.hasAttribute('src')) return;
        const src = frame.dataset.near ? frame.dataset.src : 'about:blank';
        if (frame.getAttribute('src') !== src) frame.src = src;
      };
      const paint = () => {
        const light = document.documentElement.dataset.theme === 'light';
        for (const frame of document.querySelectorAll('iframe.live')) {
          // The example stands on the ground of a code block. A diagram is drawn from its source.
          const section = (frame.dataset.section ? `&section=${frame.dataset.section}` : '') + (frame.dataset.variant ? `&variant=${frame.dataset.variant}` : '');
          const what = frame.dataset.diagram ? `&diagram=${encodeURIComponent(frame.dataset.diagram)}` : `${section}#${frame.dataset.page}`;
          frame.dataset.src = `/frame/?embed${light ? '&light' : ''}&bg=${light ? 'f6f6f7' : '0f0f11'}${what}`;
          // Measured once here, so the first ones do not wait for the observer.
          const box = frame.getBoundingClientRect();
          if (box.bottom > -600 && box.top < innerHeight + 600) frame.dataset.near = 'yes';
          near.observe(frame);
          run(frame);
        }
      };
      paint();
      // Every block of code can be copied.
      for (const block of document.querySelectorAll('pre')) {
        const button = document.getElementById('copy').content.firstElementChild.cloneNode(true);
        button.addEventListener('click', async () => {
          // Without a secure origin there is no clipboard, and nothing was copied.
          try {
            await navigator.clipboard.writeText(block.querySelector('code')?.innerText ?? block.innerText);
          } catch {
            return;
          }
          button.classList.add('copied');
          setTimeout(() => button.classList.remove('copied'), 1400);
        });
        const holder = document.createElement('div');
        holder.className = 'code';
        block.replaceWith(holder);
        holder.append(block, button);
      }
      // An example that does not fit asks for room, a little at a time.
      addEventListener('message', (event) => {
        if (event.data !== 'limn:grow') return;
        for (const frame of document.querySelectorAll('iframe.live')) {
          if (frame.contentWindow === event.source && frame.offsetHeight > 0 && frame.offsetHeight < 900) frame.style.height = `${frame.offsetHeight + 24}px`;
        }
      });
      document.getElementById('theme').addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        paint();
      });
    </script>
  </body>
</html>
