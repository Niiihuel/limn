---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { DOC_NAV } from '../data/site';
// `side`: [{ group, items: [{ href, label }] }]; `toc`: Astro's headings.
const { title, description, side = DOC_NAV, toc = [], canonical } = Astro.props;
const path = Astro.url.pathname;
---
<Base title={title} description={description} canonical={canonical}>
  <button class="docs-menu-toggle" type="button" aria-controls="docs-nav" aria-expanded="false"><Icon name="list" />Browse documentation<Icon name="chevron-down" size={12} /></button>
  <div class="shell">
    <nav id="docs-nav" class="side" aria-label="Documentation">
      {side.map(({ group, items }) => (
        <>
          <h2>{group}</h2>
          {items.map(({ href, label, children = [], fresh = false }) => (
            <>
              <a href={href} aria-current={path === href ? 'page' : undefined} class={children.length ? 'branch' : undefined}><span>{label}{fresh && <span class="new">New</span>}</span>{children.length > 0 && <Icon name="chevron-down" size={11} />}</a>
              {path === href && children.length > 0 && (
                <div class="twigs">{children.map((child) => <a href={child.href}>{child.label}</a>)}</div>
              )}
            </>
          ))}
        </>
      ))}
    </nav>
    <main id="content" class="main" tabindex="-1"><slot /></main>
    <aside class="toc">
      {toc.length > 0 && <h2>On this page</h2>}
      {toc.map(({ depth, slug, text }) => <a href={`#${slug}`} class={depth > 2 ? 'sub' : undefined}>{text}</a>)}
    </aside>
  </div>
  <script is:inline>
    // The list keeps the page being read in view, and shows its scrollbar
    // only while it moves or the pointer is over it.
    {
      const side = document.querySelector('.side');
      const toggle = document.querySelector('.docs-menu-toggle');
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        side.toggleAttribute('data-open', open);
      });
      // Not scrollIntoView: that would move the page as well as the list.
      const current = side.querySelector('[aria-current]');
      if (current) side.scrollTop = current.offsetTop - side.clientHeight / 2;
      let hide;
      side.addEventListener('scroll', () => {
        side.dataset.scrolling = '';
        clearTimeout(hide);
        hide = setTimeout(() => delete side.dataset.scrolling, 900);
      }, { passive: true });
    }
  </script>
  <script is:inline>
    // The heading being read is marked in "On this page": the last one above a line near the top.
    {
      const links = [...document.querySelectorAll('.toc a')];
      const heads = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter(Boolean);
      const mark = () => {
        let current = heads[0];
        for (const head of heads) if (head.getBoundingClientRect().top <= 96) current = head;
        // At the end of the page the last headings never reach the line.
        if (scrollY > 0 && innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = heads.at(-1);
        for (const link of links) link.classList.toggle('active', current && decodeURIComponent(link.hash) === `#${current.id}`);
      };
      if (heads.length) {
        addEventListener('scroll', mark, { passive: true });
        mark();
      }
    }
  </script>
</Base>
