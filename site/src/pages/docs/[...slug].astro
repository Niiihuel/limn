---
import { getCollection, render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Moved from '../../components/Moved.astro';
import { FOUNDATIONS } from '../../data/site';

export async function getStaticPaths() {
  const guides = await getCollection('docs');
  // docs/README.md is the index of the guides.
  return guides.map((guide) => ({ params: { slug: guide.id === 'readme' ? undefined : guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const foundation = FOUNDATIONS.find(({ guide: id }) => id === guide.id);
const { Content, headings } = await render(guide);
const title = headings.find((heading) => heading.depth === 1)?.text ?? guide.id;
---
{foundation ? <Moved href={`/design-system/${foundation.id}/`} title={foundation.title} /> : <Shell title={title} toc={headings.filter((heading) => heading.depth === 2 || heading.depth === 3)}>
  <p class="docs-breadcrumb">Documentation<span>/</span>{title}</p>
  <article class="prose"><Content /></article>
</Shell>}
