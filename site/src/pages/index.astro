---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LayoutField from '../components/home/LayoutField.astro';
import { COMPONENTS, REPO, groups } from '../data/site';
import '../styles/home.css';
import cargo from '../../../Cargo.toml?raw';

// The workspace's version, so the release that changes it changes the page too.
const version = cargo.match(/^version = "(.+)"$/m)![1];

const install = 'cargo add limn limn-egui';
const example = `use limn::{Button, Component, ComponentPalette, Element, Text};

fn view(state: &State, palette: ComponentPalette) -> Element {
    Element::column(vec![
        Text::new(&state.title, palette).render(),
        Button::new("save", "Save changes", palette).render(),
    ])
    .gap(12.0)
}

fn update(state: &mut State, action: &UiAction) {
    if let UiAction::Clicked { id } = action {
        if id == "save" { state.save(); }
    }
}`;
const steps = [
  ['State', 'Yours. A plain value your application owns and changes.'],
  ['Element', 'A description of the window, rebuilt from the state whenever it changes.'],
  ['UiTree', 'Lays the description out and keeps what a description cannot: focus, scroll, hover, motion.'],
  ['Frame', 'Drawing commands, hit regions and accessibility nodes, for any renderer to paint.'],
];
const built = [
  ['universal-access', 'Accessibility', 'Every control tells the platform its role, its name and its state. Screen readers get them through AccessKit.', '/docs/accessibility/'],
  ['activity', 'Motion', 'Springs and transitions that survive a rebuild, one switch to turn them off, and the browser’s preference read for you.', '/docs/animation/'],
  ['arrow-repeat', 'Hot reload', 'Edit a view while the application runs. The window changes; the state stays where it was.', '/docs/hot-reload/'],
  ['palette', 'Themes and tokens', 'One palette colors every component. Radii and durations are tokens you set once.', '/design-system/'],
  ['code-slash', 'A code editor', 'Carets, selections, undo, syntax colors, a minimap and Vim keys, over a buffer you own.', '/components/code-editor/'],
  ['droplet-half', 'Liquid glass', 'A material that refracts what is behind it, written as a shader and documented number by number.', '/docs/liquid-glass/'],
];
const numbers = [
  [String(COMPONENTS.length), 'components, each with a live page'],
  ['5', 'crates on crates.io'],
  ['2', 'targets: Linux and WebAssembly'],
  ['1,200+', 'tests run on every change'],
];
---
<Base variant="landing" bodyClass="home" description="limn is a native UI library for Rust: components, layout, motion and accessibility, drawn from your state.">
  <main class="limn-home" id="content" tabindex="-1">
    <section class="home-hero" aria-labelledby="hero-title">
      <LayoutField />
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-copy">
        <a class="hero-chip" href={`${REPO}/blob/main/CHANGELOG.md`}><span class="dot"></span> {version} is on crates.io <Icon name="arrow-right" size={12} /></a>
        <h1 id="hero-title">Interfaces,<br />drawn in Rust<span>.</span></h1>
        <p class="hero-lead">limn is a native UI library. You describe the window from your state; it brings the components, the layout, the motion and the accessibility.</p>
        <div class="hero-actions">
          <a class="home-button" href="/docs/getting-started/">Get started <Icon name="arrow-up-right" size={16} /></a>
          <div class="install"><Code code={install} lang="sh" themes={{ light: 'github-dark-default', dark: 'github-dark-default' }} /></div>
        </div>
      </div>
    </section>

    <section class="numbers" aria-label="limn in numbers">
      {numbers.map(([value, label]) => <div><strong>{value}</strong><span>{label}</span></div>)}
    </section>

    <section class="block index" aria-labelledby="index-title">
      <header>
        <p class="kicker">The library</p>
        <h2 id="index-title">{COMPONENTS.length} components.<br /><span>Each one runs on its page.</span></h2>
      </header>
      <dl class="index-rows">
        {groups(COMPONENTS).map(({ group, items }) => (
          <div>
            <dt>{group}</dt>
            <dd>{items.map(({ id, title, new: fresh }) => <a href={`/components/${id}/`}>{title}{fresh && <span class="new">New</span>}</a>)}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href="/components/">Browse the components <Icon name="arrow-right" size={15} /></a>
    </section>

    <section class="block model" aria-labelledby="model-title">
      <header>
        <p class="kicker">How a frame is made</p>
        <h2 id="model-title">State in.<br /><span>Interface out.</span></h2>
      </header>
      <div class="model-grid">
        <ol class="steps">
          {steps.map(([name, copy], index) => <li><span class="step-index">{String(index + 1).padStart(2, '0')}</span><div><h3>{name}</h3><p>{copy}</p></div></li>)}
        </ol>
        <figure class="listing">
          <figcaption>view.rs</figcaption>
          <Code code={example} lang="rust" themes={{ light: 'github-dark-default', dark: 'github-dark-default' }} />
        </figure>
      </div>
      <a class="text-link" href="/docs/concepts/">Read the concepts <Icon name="arrow-right" size={15} /></a>
    </section>

    <section class="block" aria-labelledby="built-title">
      <header>
        <p class="kicker">Already built</p>
        <h2 id="built-title">The parts nobody<br /><span>wants to write twice.</span></h2>
      </header>
      <div class="bento">
        {built.map(([icon, title, copy, href]) => (
          <a class="card" href={href}>
            <Icon name={icon} size={18} />
            <h3>{title}</h3>
            <p>{copy}</p>
            <span class="card-go"><Icon name="arrow-up-right" size={14} /></span>
          </a>
        ))}
      </div>
    </section>

    <section class="block used" aria-labelledby="used-title">
      <p class="kicker">Shaped by real work</p>
      <div class="used-row">
        <h2 id="used-title">The interface of<br /><span class="strong">openADE</span></h2>
        <p>A native Rust development environment for working with coding agents. Every panel, menu and editor in it is limn: the library grows from what a real application needs.</p>
      </div>
    </section>

    <section class="block ending" aria-labelledby="ending-title">
      <h2 id="ending-title">Draw yours<span>.</span></h2>
      <div class="hero-actions">
        <a class="home-button" href="/docs/getting-started/">Get started <Icon name="arrow-up-right" size={16} /></a>
        <div class="install"><Code code={install} lang="sh" themes={{ light: 'github-dark-default', dark: 'github-dark-default' }} /></div>
      </div>
      <nav class="ending-links" aria-label="More about limn"><a href="/docs/">Documentation</a><a href="/components/">Components</a><a href="/design-system/">Design system</a><a href={REPO}>GitHub <Icon name="arrow-up-right" size={13} /></a><a href="https://crates.io/crates/limn">crates.io <Icon name="arrow-up-right" size={13} /></a></nav>
    </section>
  </main>
</Base>
