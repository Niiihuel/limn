---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import { COMPONENTS, REPO } from '../data/site';

const counter = `fn view(state: &State, palette: ComponentPalette) -> Element {
    Element::column(vec![
        Element::text(format!("Count: {}", state.count))
            .foreground(palette.text),
        Button::new("increment", "Increase", palette).render(),
    ])
    .gap(16.0)
}

fn update(state: &mut State, action: &UiAction) {
    if let UiAction::Clicked { id } = action {
        if id == "increment" {
            state.count += 1;
        }
    }
}`;

const capabilities = [
  ['Declarative', 'The window is a function of your state, rebuilt every frame. Controls keep their own state by ID.', ['Element', 'UiTree', 'UiAction']],
  ['Backend-neutral', 'The core has no window or graphics dependency: it produces drawing commands. An egui and wgpu backend is included.', ['Frame', 'DrawCommand', 'limn-egui']],
  ['Animated by default', 'Menus, dialogs, tooltips and controls move without application code, and one switch turns all of it off.', ['Motion', 'set_reduced_motion']],
  ['Themeable', 'Three colors define a palette; tokens set corner radii and pace for the whole application.', ['Theme', 'ComponentPalette', 'Tokens']],
  ['Testable', 'A test lays out a tree and inspects the frame. No window, no GPU, no screenshots to compare.', ['UiTree::layout', 'Frame::regions']],
  ['A real code editor', 'A rope-backed editor with folding, a minimap, search and Vim keys, and Tree-sitter highlighting behind a feature.', ['CodeEditor', 'limn-editor', 'limn-language']],
  ['Native Markdown and diagrams', 'Markdown, Mermaid flowcharts and sequence diagrams are laid out and drawn by the library, not by a web view.', ['Markdown', 'DiagramViewer']],
  ['Liquid glass', 'A material that blurs, tints and refracts the scene behind a surface, with a rim that bends what enters it.', ['GlassMaterial', 'NavigationBar']],
  ['Runs in a browser', 'The same tree compiles to WebAssembly. Every example on this site is the library, not a recording.', ['wasm32', 'WebGL 2', 'WebGPU']],
];
---
<Base>
  <section class="hero">
    <div>
      <span class="pill">Open source · MIT or Apache-2.0</span>
      <h1>Native interfaces for Rust, drawn from your state.</h1>
      <p class="lead">
        limn lays out a tree of elements, keeps the state of every control by its ID, and hands a backend the drawing
        commands. {COMPONENTS.length} components with a live page each, animated by default, testable without a window.
      </p>
      <div class="actions">
        <a class="button primary" href="/docs/getting-started/">Get started →</a>
        <a class="button" href="/components/">Browse components</a>
      </div>
      <ul class="facts">
        <li>Linux today, and the browser through WebAssembly · version 0.1, the API still changes</li>
      </ul>
      <code class="cargo">limn = {`{ git = "${REPO}" }`}</code>
    </div>
    <div class="window">
      <header><i></i><i></i><i></i><span>main.rs</span></header>
      <Code code={counter} lang="rust" themes={{ light: 'github-light', dark: 'github-dark-default' }} />
    </div>
  </section>

  <section class="band">
    <p class="eyebrow">Live</p>
    <h2>This is the library, running in your browser.</h2>
    <p class="lead">The gallery below is compiled from the same Rust that draws a desktop window. Click through it.</p>
    <div class="window" style="margin-top:32px">
      <header><i></i><i></i><i></i><span>limn-gallery — Rust &amp; WebAssembly</span></header>
      <iframe title="limn gallery" src="/frame/" loading="lazy"></iframe>
    </div>
  </section>

  <section class="band">
    <p class="eyebrow">Capabilities</p>
    <h2>What a desktop application needs, in one tree.</h2>
    <div class="grid">
      {capabilities.map(([title, text, tags]) => (
        <article>
          <h3>{title}</h3>
          <p>{text}</p>
          <div class="tags">{tags.map((tag) => <code>{tag}</code>)}</div>
        </article>
      ))}
    </div>
  </section>
</Base>
