---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Lanyard from '../components/home/Lanyard.astro';
import { REPO } from '../data/site';
import '../styles/home.css';

const example = `use limn::{Button, Component, ComponentPalette, Element, Text};

fn view(state: &State, palette: ComponentPalette) -> Element {
    Element::column(vec![
        Text::new(&state.title, palette).render(),
        Button::new("save", "Save changes", palette).render(),
    ])
    .gap(12.0)
}`;
const dependency = `limn = { git = "${REPO}" }`;
const principles = [
  ['01', 'Your state stays yours.', 'Your application owns the values and actions. Stable IDs keep focus, scroll and transitions in place.', 'State → Element'],
  ['02', 'Every detail belongs.', 'Controls, menus and motion share a visual language. Build a whole interface from pieces that work together.', 'Element → UiTree'],
  ['03', 'Bring your renderer.', 'limn produces drawing commands. Use the egui backend, or give your own renderer a frame to draw.', 'UiTree → Frame'],
];
---
<Base variant="landing" bodyClass="home" description="limn is a native UI library for Rust. Build interfaces from your state, with coherent components, retained interactions and motion.">
  <main class="limn-home" id="content" tabindex="-1">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-halftone" aria-hidden="true"></div>
      <div class="home-hero-inner">
        <div class="home-intro">
          <p class="home-kicker"><span></span> Native UI for Rust <span class="home-version">/ 0.1 preview</span></p>
          <h1 id="home-title">Native<br />by design<span class="home-period">.</span></h1>
          <p class="home-lead">Describe your interface in Rust. limn brings the layout, interactions and motion. Your state. Your backend. Your application.</p>
          <div class="home-actions">
            <a class="home-button" href="/docs/getting-started/">Get started <Icon name="arrow-up-right" size={18} /></a>
            <a class="home-text-link" href="/components/">Browse components <Icon name="arrow-right" size={17} /></a>
          </div>
          <p class="home-platforms">Open source <span>·</span> Linux + WebAssembly <span>·</span> MIT / Apache-2.0</p>
        </div>
        <Lanyard />
      </div>
      <div class="home-hero-bottom"><span>LESS BETWEEN AN IDEA AND AN INTERFACE</span><a href="#built-in">Explore limn <Icon name="arrow-down" size={14} /></a></div>
    </section>

    <section class="home-principles home-section" id="built-in" aria-labelledby="home-principles-title">
      <div class="home-section-heading">
        <p class="home-kicker">The way it works</p>
        <h2 id="home-principles-title">One tree.<br /><span>A whole interface.</span></h2>
        <p>Describe what belongs on screen. The tree remembers how it feels.</p>
      </div>
      <div class="home-principle-grid">
        {principles.map(([number, title, copy, flow]) => (
          <article>
            <span class="home-number">{number}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
            <span class="home-flow">{flow}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="home-code-section home-section" aria-labelledby="home-code-title">
      <div class="home-section-heading">
        <p class="home-kicker">Start small. Build naturally.</p>
        <h2 id="home-code-title">In your<br /><span>element.</span></h2>
        <p>Ordinary Rust, a few components, and a view of your state. Rebuild the description. Keep the interaction.</p>
        <a class="home-text-link" href="/docs/concepts/">Meet the model <Icon name="arrow-up-right" size={17} /></a>
      </div>
      <div class="home-code-window">
        <div class="home-window-bar"><span><i></i><i></i><i></i></span><span>view.rs</span><span>RUST</span></div>
        <Code code={example} lang="rust" themes={{ light: 'github-dark-default', dark: 'github-dark-default' }} />
        <div class="home-code-note"><span class="home-status-dot"></span> State in. Interface out.</div>
      </div>
    </section>

    <section class="home-demo-section home-section" aria-labelledby="home-demo-title">
      <div class="home-demo-heading">
        <div><p class="home-kicker">The real thing</p><h2 id="home-demo-title">Go ahead.<br /><span>Press a button.</span></h2></div>
        <div><p>This is limn running as WebAssembly. The same Rust that draws a desktop window, right here.</p><a class="home-text-link" href="/gallery/">Open the full gallery <Icon name="arrow-up-right" size={17} /></a></div>
      </div>
      <div class="home-live-window">
        <div class="home-window-bar"><span class="home-live-indicator"><span class="home-status-dot"></span> LIVE EXAMPLE</span><span>Modal / AlertDialog</span><a href="/components/dialog/" aria-label="Read the Modal and AlertDialog guide"><Icon name="arrow-up-right" size={17} /></a></div>
        <iframe class="home-live" title="Interactive limn dialog examples" src="/frame/?embed&amp;bg=101012#dialog" loading="lazy"></iframe>
      </div>
      <div class="home-demo-links"><a href="/design-system/">Explore the foundations <Icon name="arrow-right" size={16} /></a><a href="/patterns/">Build with patterns <Icon name="arrow-right" size={16} /></a></div>
    </section>

    <section class="home-used home-section" aria-labelledby="home-used-title">
      <p class="home-kicker">Shaped by real work</p>
      <div class="home-used-content"><h2 id="home-used-title">The UI behind<br /><span class="home-openade">openADE</span></h2><div><p>A native Rust development environment for working with coding agents. limn brings its interfaces to life.</p><span class="home-used-note">Built in Rust. Built with limn.</span></div></div>
    </section>

    <section class="home-ending home-section" aria-labelledby="home-ending-title">
      <p class="home-kicker">Your next interface starts here</p>
      <h2 id="home-ending-title">Make it<br /><span>your own.</span></h2>
      <div class="home-ending-row"><a class="home-button" href="/docs/getting-started/">Start building <Icon name="arrow-up-right" size={18} /></a><div class="home-install"><span>ADD LIMN FROM GIT</span><Code code={dependency} lang="toml" themes={{ light: 'github-dark-default', dark: 'github-dark-default' }} /></div></div>
      <nav class="home-bottom-links" aria-label="More about limn"><a href="/docs/">Documentation</a><a href="/components/">Components</a><a href="/design-system/">Design system</a><a href={REPO}>GitHub <Icon name="arrow-up-right" size={14} /></a></nav>
    </section>
  </main>
</Base>
