---
import { getEntry, render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import Example from '../../components/Example.astro';
import Moved from '../../components/Moved.astro';
import { CATALOG, FOUNDATIONS, PATTERNS, REPO, exampleId } from '../../data/site';
import { lead } from '../../data/guide';
import { sectionSource, variantSources } from '../../data/examples';

export function getStaticPaths() {
  return CATALOG.map((component) => ({ params: { id: component.id }, props: { component } }));
}

const { component } = Astro.props;
const foundation = FOUNDATIONS.find(({ page }) => page === component.id);
const pattern = PATTERNS.some(({ id }) => id === component.id);
// The guide, docs/components/<id>.md, if the component has one yet.
const guide = await getEntry('components', component.id);
const { Content, headings } = guide ? await render(guide) : { Content: null, headings: [] };
const about = lead(guide?.body);
const file = `crates/limn-gallery/src/pages/${component.source}.rs`;
const usageSection = guide?.body.match(/## Usage\s*\n([\s\S]*?)(?=\n## |$)/)?.[1];
const blocks = [...(guide?.body.matchAll(/```rust\s*\n([\s\S]*?)```/g) ?? [])].map((block) => block[1].trim());
const code = usageSection?.match(/```rust\s*\n([\s\S]*?)```/)?.[1].trim() ?? blocks.find((block) => /\b(?:fn|let|const)\b|::new\(/.test(block)) ?? '';
// Every variant of every section of the gallery page is an example of its own; the first is the page's preview.
const examples = component.sections.flatMap(({ title, variants }, section) => {
  const sources = variantSources(component.source, title, variants.length);
  return variants.map((_, variant) => ({
    section,
    variant,
    // The first example of a section is where the sidebar's branch for it leads.
    anchor: variant === 0 && title ? exampleId(title) : undefined,
    name: title || component.title,
    place: variants.length > 1 ? `${variant + 1} / ${variants.length}` : '',
    code: sources[variant] ?? (variants.length === 1 ? sectionSource(component.source, title) : ''),
  }));
}).slice(1);
const tall = component.group === 'Overlays' ? 420 : 240;
const toc = [
  { depth: 2, slug: 'preview', text: 'Preview' },
  ...(examples.length ? [{ depth: 2, slug: 'examples', text: 'Examples' }] : []),
  ...headings.filter(({ depth }) => depth === 2 || depth === 3),
  { depth: 2, slug: 'api-reference', text: 'API reference' },
];
---
{foundation ? <Moved href={`/design-system/${foundation.id}/`} title={foundation.title} /> : <Shell title={component.title} description={about || `${component.title}, a limn component.`} toc={toc}>
  <header class="docs-heading">
    <p class="docs-breadcrumb"><a href={pattern ? '/patterns/' : '/components/'}>{pattern ? 'Patterns' : 'Components'}</a><span>/</span>{component.group}</p>
    <h1>{component.title}</h1>
    {about && <p class="lead">{about}</p>}
    <div class="docs-meta"><span>{pattern ? 'Composed pattern' : 'Native component'}</span><a href={`${REPO}/blob/main/docs/components/${component.id}.md`}>Guide source<Icon name="arrow-up-right" size={12} /></a></div>
  </header>

  <section class="docs-section" aria-labelledby="preview">
    <h2 id="preview">Preview</h2>
    <Example anchor={component.sections[0]?.title ? exampleId(component.sections[0].title) : undefined} page={component.id} section={0} variant={0} title={component.title} code={code} codeSource={`${REPO}/blob/main/${code ? `docs/components/${component.id}.md` : file}`} height={tall + 80} />
  </section>

  {examples.length > 0 && (
    <section class="docs-section" aria-labelledby="examples">
      <h2 id="examples">Examples</h2>
      <p class="docs-muted">Each one is the library drawing it. Press, type and hover.</p>
      <div class="specimens">
        {examples.map(({ section, variant, anchor, name, place, code }) => (
          <Example anchor={anchor} page={component.id} section={section} variant={variant} title={`${component.title}, ${name} ${place}`} label={name} place={place} code={code} codeSource={`${REPO}/blob/main/${file}`} height={tall} />
        ))}
      </div>
    </section>
  )}

  {Content ? (
    <article class="prose guide"><Content /></article>
  ) : (
    <div class="prose">
      <h2>Reference</h2>
      <p>
        This component has no guide of its own yet. Its options are in the <a href="/docs/components/">components table</a>,
        and every builder method in the API documentation: <code>cargo doc -p limn --open</code>.
      </p>
    </div>
  )}
  <section class="docs-section prose" aria-labelledby="api-reference">
    <h2 id="api-reference">API reference</h2>
    <p>The guide covers composition, options and actions. Generate the complete Rust type and builder reference from the checkout:</p>
    <pre><code>cargo doc -p limn --open</code></pre>
    <p><a href="/docs/components/">Component API overview</a> · <a href="/docs/concepts/#who-owns-state">State and actions</a></p>
  </section>
  <p class="source"><Icon name="code-slash" size={14} /> The example is drawn by <a href={`${REPO}/blob/main/${file}`}><code>{file}</code></a>.</p>
</Shell>}
