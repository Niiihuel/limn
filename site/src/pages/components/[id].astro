---
import { getEntry, render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import { COMPONENTS, REPO, groups } from '../../data/site';
import { lead } from '../../data/guide';

export function getStaticPaths() {
  return COMPONENTS.map((component) => ({ params: { id: component.id }, props: { component } }));
}

const { component } = Astro.props;
// The guide, docs/components/<id>.md, if the component has one yet.
const guide = await getEntry('components', component.id);
const { Content, headings } = guide ? await render(guide) : { Content: null, headings: [] };
const about = lead(guide?.body);
const file = `crates/limn-gallery/src/pages/${component.source}.rs`;
const side = [
  { group: 'Components', items: [{ href: '/components/', label: 'All components' }] },
  ...groups(COMPONENTS).map(({ group, items }) => ({ group, items: items.map(({ id, title }) => ({ href: `/components/${id}/`, label: title })) })),
];
const toc = [{ depth: 2, slug: 'example', text: 'Example' }, ...headings.filter(({ depth }) => depth === 2 || depth === 3)];
---
<Shell title={component.title} description={about || `${component.title}, a limn component.`} side={side} toc={toc}>
  <h1>{component.title}</h1>
  {about && <p class="lead">{about}</p>}

  <div class="example" id="example"><span class="eyebrow">Example</span><span class="eyebrow">Rust &amp; WebAssembly</span></div>
  <div class="window">
    <header><i></i><i></i><i></i><span>{component.title} — limn</span></header>
    <iframe title={`${component.title}, live`} data-page={component.id} loading="lazy"></iframe>
  </div>

  {Content ? (
    <article class="prose guide"><Content /></article>
  ) : (
    <div class="prose">
      <h2>Reference</h2>
      <p>
        This component has no guide of its own yet. Its options are in the <a href="/docs/components/">components table</a>,
        and every builder method in the API documentation: <code>cargo doc -p limn --open</code>.
      </p>
    </div>
  )}
  <p class="source">The example is drawn by <a href={`${REPO}/blob/main/${file}`}><code>{file}</code></a>.</p>
</Shell>
