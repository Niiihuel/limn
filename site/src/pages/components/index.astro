---
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import { COMPONENTS, groups } from '../../data/site';
import { lead } from '../../data/guide';

const guides = new Map((await getCollection('components')).map((guide) => [guide.id, guide]));
const byGroup = groups(COMPONENTS);
const toc = byGroup.map(({ group }) => ({ depth: 2, slug: group.toLowerCase(), text: group === 'System' ? 'Primitives' : group }));
---
<Shell title="Components" description="Native limn components, with usage guides and real Rust previews." toc={toc}>
  <header class="docs-heading">
    <p class="docs-breadcrumb">Documentation<span>/</span>Components</p>
    <h1>Components</h1>
    <p class="lead">Native building blocks for your interface. Try the preview, copy the Rust usage, and find the options and actions in each guide.</p>
    <p class="docs-muted">Set up <a href="/design-system/">the design system</a>, or explore <a href="/patterns/">composed patterns</a>.</p>
  </header>
  <div class="component-index">
    {byGroup.map(({ group, items }) => (
      <section class="docs-section" aria-labelledby={group.toLowerCase()}>
        <h2 id={group.toLowerCase()}>{group === 'System' ? 'Primitives' : group}<span class="section-count">{items.length}</span></h2>
        <div class="docs-index">
          {items.map(({ id, title, new: fresh }) => {
            const about = lead(guides.get(id)?.body);
            return <a href={`/components/${id}/`}><div><h3>{title}{fresh && <span class="new">New</span>}</h3>{about && <p>{about}</p>}</div><Icon name="arrow-right" size={14} /></a>;
          })}
        </div>
      </section>
    ))}
  </div>
</Shell>
